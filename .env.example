# Local development only. Production uses deploy/production.env and Docker Secrets.
NODE_ENV=development
BACKEND_PORT=3000
APP_ORIGIN=http://localhost:5173
# Public issuer used by the browser and token validation.
OIDC_ISSUER=http://127.0.0.1:8080
# Docker-only backchannel for the local intranet SPI. Leave empty when running
# backend directly on the host or when using an HTTPS issuer reachable directly.
OIDC_BACKCHANNEL_ORIGIN=http://host.docker.internal:8080
OIDC_CLIENT_ID=oidc_b79664a0a1fddecefe7856581a592eb0
OIDC_CLIENT_SECRET_FILE=./.secrets/oidc_client_secret
OIDC_SESSION_ENCRYPTION_KEY_FILE=./.secrets/oidc_session_encryption_key

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bulkmail
POSTGRES_PASSWORD=bulkmail-local
POSTGRES_DB=bulkmail

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MAILGRID_HOST=
MAILGRID_USER=
MAILGRID_PASS=
MAILGRID_SENDER=no-reply@example.com
MAILGRID_SENDER_NAME=BulkMail Pro
MAILGRID_WEBHOOK_TOKEN=local-webhook-token

CREFITO11_LOGO_PATH=/assets/logos/CREFITO 11 - Marca - Neg 2 Completa.png
CREFITO11_LOGO_URL=http://localhost:5173/api/assets/crefito11-email-logo.png

WORKER_CONCURRENCY=3
THROTTLE_RATE=50
UPLOAD_DIR=./uploads
