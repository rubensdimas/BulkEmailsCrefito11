{
  "name": "bulkmail-backend",
  "version": "1.0.0",
  "description": "Backend API for BulkMail Pro - Email sending system",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "verify:production-artifacts": "node scripts/verifyProductionArtifacts.js",
    "start": "node dist/app.js",
    "migrate": "knex migrate:latest",
    "migrate:prod": "knex --knexfile dist/config/knexfile.js --env production migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "worker": "ts-node src/queue/emailWorker.ts",
    "reconcile:email-jobs": "node dist/scripts/reconcileEmailJobs.js",
    "reconcile:email-jobs:dev": "ts-node src/scripts/reconcileEmailJobs.ts",
    "test": "jest",
    "test:integration": "RUN_DATABASE_INTEGRATION=true RUN_REDIS_INTEGRATION=true jest src/repositories/emailLogRepository.integration.test.ts src/queue/emailQueue.integration.test.ts --runInBand",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "email",
    "bulkmail",
    "smtp",
    "queue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fast-csv/parse": "^4.3.6",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
